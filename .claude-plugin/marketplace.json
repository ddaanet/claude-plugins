  },
  "metadata": {
    "description": "Personal plugin collection by ddaanet."
  },
  "plugins": [
    {
      "name": "ddaa",
      "source": {
        "source": "git-subdir",
        "url": "ddaanet/skills",
        "path": "plugins/ddaa"
      },
      "description": "Skills (EN) — brief, preflight, proof, bilingual skill creator, bookkeeping.",
      "version": "0.1.2",
      "author": {
        "name": "David Allouche"
      },
      "repository": "https://github.com/ddaanet/skills",
      "license": "MIT",
      "keywords": [
        "brief",
        "preflight",
        "proof",
        "skill-creator",
        "bookkeeping",
        "english"
      ]
    },
    {
      "name": "ddaa-fr",
      "source": {
        "source": "git-subdir",
        "url": "ddaanet/skills",
        "path": "plugins/ddaa-fr"
      },
      "description": "Skills (FR) — brief, preflight, relecture, saisie comptable.",
      "version": "0.1.2",
      "author": {
        "name": "David Allouche"
      },
      "repository": "https://github.com/ddaanet/skills",
      "license": "MIT",
      "keywords": [
        "brief",
        "preflight",
        "relecture",
        "saisie-comptable",
        "french",
        "français"
      ]
    },
    {
      "name": "edify",
      "source": {
        "source": "github",
        "repo": "ddaanet/edify-plugin"
      },
      "description": "Opinionated agent framework for Claude Code",
      "author": {
        "name": "David Allouche"
      },
      "repository": "https://github.com/ddaanet/edify-plugin",
      "license": "MIT",
      "keywords": [
        "agent-framework",
        "workflows",
        "skills",
        "hooks"
      ]
    },
    {
      "name": "handoff",
      "source": {
        "source": "github",
        "repo": "ddaanet/handoff"
      },
      "description": "Pre-/clear task snapshot for Claude Code: agent notes current task + open decisions, a PostToolUse hook composes them with auto-extracted last-N user prompts and files touched from the session JSONL.",
      "version": "0.5.1",
      "author": {
        "name": "David Allouche"
      },
      "repository": "https://github.com/ddaanet/handoff",
      "license": "MIT",
      "keywords": [
        "handoff",
        "context",
        "session",
        "clear",
        "stop-hook"
      ]
    },
    {
      "name": "gitmoji",
      "source": {
        "source": "github",
        "repo": "ddaanet/gitmoji"
      },
      "description": "Commit-msg git hook that replaces conventional-commit prefixes (feat:, fix:, docs:, ...) with gitmoji emojis. Ships an installer command that stows the hook into the current git repo.",
      "version": "0.5.0",
      "author": {
        "name": "David Allouche"
      },
      "repository": "https://github.com/ddaanet/gitmoji",
      "license": "MIT",
      "keywords": [
        "git",
        "gitmoji",
        "commit-msg",
        "hook",
        "conventional-commits"
      ]
    },
    {
      "name": "double-shot-latte",
      "source": {
        "source": "github",
        "repo": "ddaanet/double-shot-latte"
      },
      "description": "Auto-continue stop hook: uses a Claude judge to decide if the agent should keep working instead of stopping prematurely.",
      "version": "1.2.0",
      "author": {
        "name": "Jesse Duffield",
        "url": "https://github.com/obra"
      },
      "repository": "https://github.com/ddaanet/double-shot-latte",
      "license": "MIT",
      "keywords": [
        "stop-hook",
        "auto-continue",
        "judge",
        "continuation"
      ]
    },
    {
      "name": "gitlore",
      "source": {
        "source": "github",
        "repo": "ddaanet/gitlore"
      },
      "description": "Versioned, shared, git-backed memory for Claude Code.",
      "version": "0.2.4",
      "author": {
        "name": "David Allouche"
      },
      "repository": "https://github.com/ddaanet/gitlore",
      "license": "MIT",
      "keywords": [
        "memory",
        "git",
        "submodule",
        "semantic-merge",
        "claude-code"
      ]
    },
    {
      "name": "autoname",
      "source": {
        "source": "github",
        "repo": "ddaanet/autoname"
      },
      "description": "Title the current Claude Code session from conversation context. The /autoname skill picks a concise title and, inside tmux, types /rename for you once the prompt goes idle; otherwise it prints a /rename line to paste.",
      "version": "0.1.1",
      "author": {
        "name": "David Allouche"
      },
      "repository": "https://github.com/ddaanet/autoname",
      "license": "MIT",
      "keywords": [
        "autoname",
        "rename",
        "session",
        "tmux",
        "title"
      ]
    },
    {
      "name": "onekeys",
      "source": {
        "source": "github",
        "repo": "ddaanet/onekeys"
      },
      "description": "UserPromptSubmit hook that expands single-character prompts into full instructions (c → Continue, h → /handoff:handoff). Mappings live in ~/.claude/onekeyers.txt.",
      "version": "0.2.0",
      "author": {
        "name": "David Allouche"
      },
      "repository": "https://github.com/ddaanet/onekeys",
      "license": "MIT",
      "keywords": [
        "prompt",
        "shorthand",
        "userpromptsubmit",
        "hook",
        "expansion"
      ]
    }
  ]
}
