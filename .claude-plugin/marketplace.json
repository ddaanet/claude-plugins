{
  "name": "ddaanet",
  "owner": {
    "name": "David Allouche",
    "email": "david@ddaa.net"
  },
  "metadata": {
    "description": "Personal plugin collection by ddaanet."
  },
  "plugins": [
    {
      "name": "ddaa",
      "source": {
        "source": "git-subdir",
        "url": "ddaanet/skills",
        "path": "plugins/ddaa"
      },
      "description": "Skills (EN) — brief, preflight, proof, bilingual skill creator, bookkeeping.",
      "version": "0.1.2",
      "author": {
        "name": "David Allouche"
      },
      "repository": "https://github.com/ddaanet/skills",
      "license": "MIT",
      "keywords": [
        "brief",
        "preflight",
        "proof",
        "skill-creator",
        "bookkeeping",
        "english"
      ]
    },
    {
      "name": "ddaa-fr",
      "source": {
        "source": "git-subdir",
        "url": "ddaanet/skills",
        "path": "plugins/ddaa-fr"
      },
      "description": "Skills (FR) — brief, preflight, relecture, saisie comptable.",
      "version": "0.1.2",
      "author": {
        "name": "David Allouche"
      },
      "repository": "https://github.com/ddaanet/skills",
      "license": "MIT",
      "keywords": [
        "brief",
        "preflight",
        "relecture",
        "saisie-comptable",
        "french",
        "français"
      ]
    },
    {
      "name": "handoff",
      "source": {
        "source": "github",
        "repo": "ddaanet/handoff"
      },
      "description": "Pre-/clear task snapshot for Claude Code: agent notes current task + open decisions, a PostToolUse hook composes them with auto-extracted last-N user prompts and files touched from the session JSONL.",
      "version": "0.6.0",
      "author": {
        "name": "David Allouche"
      },
      "repository": "https://github.com/ddaanet/handoff",
      "license": "MIT",
      "keywords": [
        "handoff",
        "context",
        "session",
        "clear",
        "stop-hook"
      ]
    },
    {
      "name": "gitmoji",
      "source": {
        "source": "github",
        "repo": "ddaanet/gitmoji"
      },
      "description": "Commit-msg git hook that replaces conventional-commit prefixes (feat:, fix:, docs:, ...) with gitmoji emojis. Ships an installer command that stows the hook into the current git repo.",
      "version": "0.5.0",
      "author": {
        "name": "David Allouche"
      },
      "repository": "https://github.com/ddaanet/gitmoji",
      "license": "MIT",
      "keywords": [
        "git",
        "gitmoji",
        "commit-msg",
        "hook",
        "conventional-commits"
      ]
    },
    {
      "name": "gitlore",
      "source": {
        "source": "github",
        "repo": "ddaanet/gitlore"
      },
      "description": "Versioned, shared, git-backed memory for Claude Code.",
      "version": "0.2.5",
      "author": {
        "name": "David Allouche"
      },
      "repository": "https://github.com/ddaanet/gitlore",
      "license": "MIT",
      "keywords": [
        "memory",
        "git",
        "submodule",
        "semantic-merge",
        "claude-code"
      ]
    },
    {
      "name": "onekeys",
      "source": {
        "source": "github",
        "repo": "ddaanet/onekeys"
      },
      "description": "UserPromptSubmit hook that expands single-character prompts into full instructions (c → Continue, h → /handoff:handoff). Mappings live in ~/.claude/onekeyers.txt.",
      "version": "0.3.0",
      "author": {
        "name": "David Allouche"
      },
      "repository": "https://github.com/ddaanet/onekeys",
      "license": "MIT",
      "keywords": [
        "prompt",
        "shorthand",
        "userpromptsubmit",
        "hook",
        "expansion"
      ]
    },
    {
      "name": "cwd-safety",
      "source": {
        "source": "github",
        "repo": "ddaanet/cwd-safety"
      },
      "description": "Keeps the agent's Bash working directory at project root: a PreToolUse(Bash) hook blocks drift-inducing `cd` commands and commands run from a drifted cwd; a PostToolUse(Bash) hook warns after the working directory changes.",
      "version": "0.1.0",
      "author": {
        "name": "David Allouche"
      },
      "repository": "https://github.com/ddaanet/cwd-safety",
      "license": "MIT",
      "keywords": [
        "cwd",
        "working-directory",
        "pretooluse",
        "posttooluse",
        "hook"
      ]
    }
  ]
}
